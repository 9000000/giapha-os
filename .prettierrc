{
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./app/globals.css",
  "tailwindFunctions": ["cn", "clsx", "twMerge"],
  "singleQuote": true,
  "jsxSingleQuote": true,
  "bracketSameLine": true,
  "trailingComma": "none",
  "printWidth": 80,
  "semi": false,
  "endOfLine": "auto"
}
